{
  "productName": "HumanLayer Neara",
  "identifier": "com.neara.humanlayer-selfhost",
  "bundle": {
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "humanlayer-neara"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QzFDQTIyMEYwRjU5MkQKUldRdFdROFBJc3JCTllIZEhnN3g0MktPVEEyN3lNc2ZhV2UxZFVjaXVTaGkwUFM2Y21lTUdPQTkK",
      "endpoints": [
        "https://nearabeast.tail9bf356.ts.net/updates/{{target}}-{{arch}}/{{current_version}}"
      ]
    }
  },
  "build": {
    "beforeBuildCommand": "bun run --cwd ../riptide-ui build && bun run --cwd ../riptide-daemon build && cp ../riptide-daemon/dist/daemon ./bin/riptided"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HumanLayer Neara",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ]
  }
}
